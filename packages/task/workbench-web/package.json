{
  "name": "@deepseek-ai/dsh-workbench-web",
  "version": "0.1.0",
  "description": "π workbench under the /workbench prefix: tasks, notes, pi TUI sessions, and dsh sessions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqwan/dsh-plugins.git",
    "directory": "packages/task/workbench-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/pi-telemetry-extension.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "public/**/*",
    "vendor/**/*"
  ],
  "license": "MIT",
  "scripts": {
    "prepare": "node ../../../scripts/build.mjs --package workbench-web",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "typescript": "^5.8.0"
  }
}
